# Copy to .env and adjust if needed. Everything is local and free —
# the LLM is an Ollama model running on your own machine. No API keys.

# Ollama server and model
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Local demo database (created by `python -m agent_app.db`)
AGENT_DB_PATH=data/fraud.db

# Agent loop safety caps
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=20000
